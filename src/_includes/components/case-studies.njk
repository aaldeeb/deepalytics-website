<section id="case-studies" class="min-h-screen flex flex-col items-center justify-center bg-[--color-surface] py-20 px-4">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-[--color-accent] mb-6">
      {{ caseStudies.heading }}
    </h2>
    <p class="text-lg text-[--color-text] mb-12">
      {{ caseStudies.intro }}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for study in caseStudies.studies %}
      <div
        class="relative group cursor-pointer rounded-xl overflow-hidden shadow-lg transform transition-transform duration-300 hover:scale-105 h-80"
        data-detail="{{ study.detail | escape }}"
        data-title="{{ study.title | escape }}"
      >
        <!-- Image fits full frame -->
        <img
          src="{{ study.image }}"
          alt="{{ study.title }}"
          class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0"
        />

        <!-- Excerpt moves on hover -->
        <p
          class="absolute top-4 left-4 font-bold text-white bg-black bg-opacity-60 p-2 transition-all duration-300 transform
                   group-hover:top-1/2 group-hover:left-1/2 group-hover:-translate-x-1/2 group-hover:-translate-y-1/2 text-center"
        >
          {{ study.excerpt }}
        </p>
      </div>
      {% endfor %}
    </div>

    <div class="mt-12 text-center">
      <a href="#contact" class="inline-block bg-[--color-accent] hover:opacity-90 text-[--color-background] font-semibold py-3 px-6 rounded-lg">
        {{ caseStudies.ctaText }}
      </a>
    </div>
  </div>

  <!-- Centered Modal with animation -->
  <dialog id="cs-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-0 m-0 opacity-0 pointer-events-none transition-opacity duration-300 z-50">
    <div class="relative bg-[--color-background] text-[--color-text] rounded-lg overflow-hidden shadow-xl w-11/12 max-w-2xl transform scale-90 transition-transform duration-300">
      <button id="cs-close" class="absolute top-4 right-4 text-[--color-muted] hover:text-[--color-accent] text-2xl leading-none">&times;</button>
      <div class="p-6">
        <h3 id="cs-modal-title" class="text-2xl font-semibold mb-4"></h3>
        <p id="cs-modal-detail" class="whitespace-pre-line"></p>
      </div>
    </div>
  </dialog>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("cs-modal");
      const titleEl = document.getElementById("cs-modal-title");
      const detailEl = document.getElementById("cs-modal-detail");
      const closeBtn = document.getElementById("cs-close");

      // Open modal
      document.querySelectorAll("[data-detail]").forEach(card => {
        card.addEventListener("click", () => {
          titleEl.textContent = card.getAttribute("data-title");
          detailEl.textContent = card.getAttribute("data-detail");
          modal.showModal();
          modal.classList.remove("opacity-0", "pointer-events-none");
          modal.classList.add("opacity-100");
          modal.querySelector("div").classList.remove("scale-90");
          modal.querySelector("div").classList.add("scale-100");
        });
      });

      // Close modal
      const closeModal = () => {
        const inner = modal.querySelector("div");
        modal.classList.remove("opacity-100");
        inner.classList.remove("scale-100");
        inner.classList.add("scale-90");
        setTimeout(() => {
          modal.classList.add("opacity-0", "pointer-events-none");
          modal.close();
        }, 300);
      };

      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", e => {
        if (e.target === modal) closeModal();
      });
    });
  </script>
</section>
