<section id="contact" class="min-h-screen flex flex-col items-center justify-center bg-[--color-surface] py-20 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-[--color-accent] mb-6">{{ contact.heading }}</h2>
    <p class="text-lg text-[--color-text] mb-12">{{ contact.intro }}</p>
    
      <div class="bg-[--color-background] p-6 rounded-lg shadow-md overflow-hidden">
        <h3 class="text-xl font-semibold text-[--color-accent] mb-3">{{ contact.calendly.heading }}</h3>
        <!-- Calendly inline widget begin -->
        <div class="calendly-inline-widget" data-url="https://calendly.com/ahmed-aldeeb/15min?hide_event_type_details=1" style="min-width:100%; height:65vh;"></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
        <!-- Calendly inline widget end -->
      </div>
    </div>

    <div class="mb-32">
      <h3 class="text-xl font-semibold text-[--color-accent] mb-3">{{ contact.direct.heading }}</h3>
      <p class="text-[--color-muted]">
        Email: <a href="mailto:{{ contact.direct.email }}" class="text-[--color-accent] hover:underline">{{ contact.direct.email }}</a><br>
        Phone: {{ contact.direct.phone }}<br>
        Location: {{ contact.direct.location }}
      </p>
    </div>

    <p class="text-lg text-[--color-text]">{{ contact.footerNote }}</p>
  
</section>