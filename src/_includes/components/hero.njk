<!-- Hero Section -->
<section id="hero" class="min-h-screen flex items-center justify-center bg-[--color-background] py-20 px-4 text-center">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[--color-text] mb-4">
      {{ hero.heading }}
    </h1>
    <h2 class="text-xl md:text-2xl text-[--color-muted] mb-8">
      {{ hero.subheading }}
    </h2>
    <p class="text-lg text-[--color-text] mb-10">
      {{ hero.description }}
    </p>
    <div class="space-x-4">
      <a href="#services" class="inline-block bg-[--color-accent] hover:opacity-90 text-[--color-background] py-3 px-6 rounded-lg">
        {{ hero.primaryCta }}
      </a>
      <a href="#about" class="inline-block border border-[--color-accent] hover:bg-[--color-surface] text-[--color-accent] py-3 px-6 rounded-lg">
        {{ hero.secondaryCta }}
      </a>
    </div>
  </div>
</section>
