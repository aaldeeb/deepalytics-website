<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ base.title }}</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-[--color-background] text-[--color-text] antialiased">
  <header class="bg-[--color-surface] text-[--color-text] py-4 px-6 shadow-md">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <div class="w-48 aspect-[3/2] overflow-hidden">
        <img src="{{ base.logo.src }}" alt="{{ base.logo.alt }}" class="w-full h-full object-cover">
      </div>
      <nav class="space-x-4">
        <a href="#services" class="hover:text-[--color-accent]">{{ base.nav.services }}</a>
        <a href="#case-studies" class="hover:text-[--color-accent]">{{ base.nav.caseStudies }}</a>
        <a href="#contact" class="hover:text-[--color-accent]">{{ base.nav.contact }}</a>
      </nav>
    </div>
  </header>

  {% include "components/hero.njk" %}
  {% include "components/about.njk" %}
  {% include "components/services.njk" %}
  {% include "components/case-studies.njk" %}
  {% include "components/contact.njk" %}

  <footer class="bg-[--color-surface] text-[--color-muted] py-10">
    <div class="max-w-6xl mx-auto px-4 md:flex md:justify-between md:items-center text-center md:text-left">
      <div class="mb-6 md:mb-0">
        <h4 class="text-lg font-semibold text-[--color-accent] mb-2">{{ base.footer.title }}</h4>
        <p class="text-sm text-[--color-muted]">{{ base.footer.tagline }}</p>
      </div>
      <div class="space-x-4 text-sm">
        <a href="#services" class="hover:text-[--color-accent]">{{ base.nav.services }}</a>
        <a href="#case-studies" class="hover:text-[--color-accent]">{{ base.nav.caseStudies }}</a>
        <a href="#contact" class="hover:text-[--color-accent]">{{ base.nav.contact }}</a>
      </div>
    </div>
    <div class="mt-6 text-center text-xs text-[--color-muted]">
      &copy; {{ now | date("yyyy") }} {{ base.footer.copyright }}
    </div>
  </footer>
</body>
</html>